# ──────────────────────────────────────────────────────────────
#  跨境电商运营中台 —— 环境变量示例
#  复制为 .env 后填入真实值：cp .env.example .env
#  .env 已在 .gitignore 中，绝不提交。
# ──────────────────────────────────────────────────────────────

# ── LLM ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk-xxxxxxxxxxxxxxxxxxxx
JWT_SECRET=please_change_me_to_a_random_string_at_least_32_chars

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=ops_user
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=crossborder_ops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 本地 docker-compose 用 disable；托管云库（Neon/Render）用 require
DATABASE_URL=postgresql://ops_user:choose_a_strong_password@localhost:5432/crossborder_ops
DB_SSL_MODE=disable

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# 云 Redis（Upstash 等）填 true，本地留空自动判断
# REDIS_USE_TLS=true

# ── 搜索 ──────────────────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key

# ── 应用 ──────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
MAX_AGENT_ITERATIONS=10
CODE_EXEC_TIMEOUT_SECONDS=10
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RETRIES=1

# ══════════════════════════════════════════════════════════════
#  跨境电商运营中台 —— 领域配置
# ══════════════════════════════════════════════════════════════

# 数据源：true = 本地模拟数据（离线可跑，演示默认）；false = 调用真实第三方 API
MOCK_ENABLED=true

# 人工审批护栏（HITL）
HITL_ENABLED=true
# 同一层可并行执行的子任务上限
AGENT_MAX_CONCURRENCY=3

# ── 审批阈值（美元 / 百分比）──────────────────────────────────
# 退款：<=100 自动；100~500 主管审批；>500 经理审批
APPROVAL_REFUND_AUTO_USD=100
APPROVAL_REFUND_SUPERVISOR_USD=500
# 补发：<=200 自动；>200 主管审批
APPROVAL_RESHIP_AUTO_USD=200
# 改价：<=5% 自动；5%~15% 主管；>15% 经理
APPROVAL_PRICE_CHANGE_AUTO_PCT=5
APPROVAL_PRICE_CHANGE_SUPERVISOR_PCT=15
# 批量补发：单次超过 5 件需审批
APPROVAL_BULK_RESHIP_COUNT=5

# ── 领域外部系统（MOCK_ENABLED=false 时必填）───────────────────
MARKET_DATA_API_KEY=
COMPETITOR_API_KEY=
FX_API_KEY=
ORDER_API_BASE=
ORDER_API_KEY=
LOGISTICS_API_BASE=
LOGISTICS_API_KEY=
INVENTORY_API_BASE=
INVENTORY_API_KEY=
REFUND_API_BASE=
REFUND_API_KEY=
TRANSLATION_API_BASE=
TRANSLATION_API_KEY=
TICKET_API_BASE=
TICKET_API_KEY=

# ── 推送渠道 ──────────────────────────────────────────────────
NOTIFY_EMAIL_FROM=ops-bot@example.com
NOTIFY_WEBHOOK_URL=

# ── 领域默认参数 ──────────────────────────────────────────────
DEFAULT_MARKET=SEA
DEFAULT_CURRENCY=USD
DEFAULT_FX_USD_CNY=7.2
DEFAULT_SHIPPING_RATE=0.08
DEFAULT_COMMISSION_RATE=0.05
DEFAULT_AD_RATE=0.10

# ── Supabase 存储（可选）──────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Google OAuth（可选）───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
